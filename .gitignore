# ==============================================
# Hugo 站点 .gitignore
# ==============================================

# Hugo 构建产物（部署时由 Actions 重新生成，无需入库）
/public/

# Hugo 资源处理缓存
/resources/

# Hugo 构建锁文件
/.hugo_build.lock

# 本地开发产生的临时文件
*.log
*.tmp

# IDE 与编辑器配置
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# ==============================================
# 敏感凭证与发布中间产物（严禁入库，见 08-敏感信息保护.md）
# ==============================================

# 本地凭证文件：存放账号密码/API Key/Cookie/Token 等，由发布脚本从环境变量或本文件读取
scripts/.secrets.local.ps1

# 平台分发转换文章（syndicate/<平台>/）默认纳入 git 提交（见 04-文章写作.md）
# 若将来某平台草稿需本地化不外传，在此单独忽略，例如：
# syndicate/wechat/

# 任何显式标注 secret 的本地文件
*.secret.ps1
*.local.secret
