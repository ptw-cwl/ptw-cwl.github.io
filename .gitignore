# ==============================================
# Hugo 站点 .gitignore
# ==============================================

# Hugo 构建产物（部署时由 Actions 重新生成，无需入库）
/public/

# Hugo 资源处理缓存
/resources/

# Hugo 构建锁文件
/.hugo_build.lock

# 本地开发产生的临时文件
*.log
*.tmp

# IDE 与编辑器配置
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
